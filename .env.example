# =============================================================================
# TradeLinks — local environment template
# =============================================================================
# COPY this file to `.env` and fill in the real values.
# IMPORTANT: `.env` MUST point to the Neon `dev` branch by default.
# For production operations use `.env.production` (see bottom of this file).
#
# Dev branch (safe default):
#   DATABASE_URL/DIRECT_URL → ep-super-mountain-aoh4zjj9.*.neon.tech
# Production branch (deliberate action only):
#   DATABASE_URL/DIRECT_URL → ep-mute-base-aotkza3n.*.neon.tech
# =============================================================================

# --- Postgres (Neon) — ADR-003 ---
# Pooled connection (host contains "-pooler"), used at runtime by workers & Vercel.
# Add &connection_limit=5 (long-lived worker) or =1 (serverless fn) to avoid
# exhausting Neon's pooled connections — see docs/operations.md.
DATABASE_URL="postgresql://neondb_owner:pass@ep-super-mountain-aoh4zjj9-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connection_limit=5"
# Direct connection (no -pooler): used by `prisma migrate` AND by pg-boss (ADR-004)
DIRECT_URL="postgresql://neondb_owner:pass@ep-super-mountain-aoh4zjj9.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# --- AI ---
# Primary: MiniMax token-plan key (sk-cp-) → Anthropic-compatible endpoint.
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimax.io/anthropic"
MINIMAX_MODEL="MiniMax-M2.7-highspeed"
# Fallbacks (used only when MINIMAX_API_KEY is empty); DeepSeek = OpenAI-compatible
DEEPSEEK_API_KEY=""
QWEN_API_KEY=""
# Google Gemini (BL-027 daily-note) — OpenAI-compatible endpoint. Key set on worker only.
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_MODEL="gemini-3.5-flash"

# --- Daily Note (BL-027) ---
# skip a day's note unless this many substantive inputs exist (no thin articles)
DAILY_NOTE_MIN_ITEMS="4"
# autopublish reviewed notes (dev default OFF; prod default ON)
DAILY_NOTE_AUTOPUBLISH="false"

# --- Python scraper service ---
# Local dev: http://localhost:8000
# Production scraper (Railway internal DNS): http://scraper.railway.internal:8000
SCRAPER_SERVICE_URL="http://localhost:8000"
# Items processed per crawl (newest-first). Caps AI cost on big feeds
MAX_ITEMS_PER_CRAWL="12"

# --- X (Twitter) viral-products signal (Radar only) ---
# App-only Bearer token → GET /2/tweets/search/recent. X is pay-per-read
# (~$0.005/post): X_MAX_READS_PER_DAY is a HARD cap (≤100 → ≤$0.50/day).
# Leave X_ENABLED unset/false until a token is set — the worker no-ops (zero cost).
X_BEARER_TOKEN=""
X_ENABLED="false"
X_MAX_READS_PER_DAY="100"
X_MIN_LIKES="50"
# Curated-accounts track (BL-034): daily read cap for polling timelines
X_ACCOUNTS_MAX_READS="200"

# --- Push / Translate switches (dev defaults OFF) ---
# CHANNEL_PUSH_ENABLED controls Telegram/Slack channel pushes from the worker.
# TRANSLATE_ENABLED controls auto-translation of non-English items.
# TELEGRAM_CHAT_ID should be a test chat/channel in dev.
CHANNEL_PUSH_ENABLED="false"
TRANSLATE_ENABLED="false"
TELEGRAM_CHAT_ID=""
# Optional: Telegram bot token only needed if you explicitly enable pushes in dev.
TELEGRAM_BOT_TOKEN=""

# --- Logging ---
LOG_LEVEL="info"

# --- Neon Auth (admin /admin/* gating — ADR-006) ---
# Auth URL from Neon Console → Project → Branch → Auth → Configuration
NEON_AUTH_BASE_URL=https://ep-super-mountain-aoh4zjj9.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=  # openssl rand -base64 32
ADMIN_EMAILS=you@example.com  # comma-separated allowlist (Google login emails)

# --- Analytics (GA4, optional; code defaults to the project ID) ---
NEXT_PUBLIC_GA_ID=G-4E8B257NHH

# =============================================================================
# Production environment template (.env.production)
# =============================================================================
# Create `.env.production` from the file above and change endpoints to the
# production branch. Use it ONLY for deliberate production operations:
#
#   pnpm db:migrate:prod
#   dotenv -e .env.production -- pnpm tsx scripts/some-backfill.ts
#
# Example production endpoints:
#   DATABASE_URL="postgresql://neondb_owner:pass@ep-mute-base-aotkza3n-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connection_limit=5"
#   DIRECT_URL="postgresql://neondb_owner:pass@ep-mute-base-aotkza3n.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
#   NEON_AUTH_BASE_URL=https://ep-mute-base-aotkza3n.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth
#
# Production switch defaults:
#   DAILY_NOTE_AUTOPUBLISH="true"
#   CHANNEL_PUSH_ENABLED="true"
#   TRANSLATE_ENABLED="true"
#   SCRAPER_SERVICE_URL="http://scraper.railway.internal:8000"   # Railway internal DNS
# =============================================================================
