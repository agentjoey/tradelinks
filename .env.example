# --- Postgres (Neon) — ADR-003 ---
# Pooled connection (host contains "-pooler"), used at runtime by workers & Vercel.
# Add &connection_limit=5 (long-lived worker) or =1 (serverless fn) to avoid
# exhausting Neon's pooled connections — see docs/operations.md.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/tradelinks?sslmode=require&pgbouncer=true&connection_limit=5"
# Direct connection (no -pooler): used by `prisma migrate` AND by pg-boss (ADR-004)
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/tradelinks?sslmode=require"

# --- AI ---
# Primary: MiniMax token-plan key (sk-cp-) → Anthropic-compatible endpoint.
# (M2 is a reasoning model; client floors max_tokens to leave room for thinking.)
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimax.io/anthropic"
MINIMAX_MODEL="MiniMax-M2.7-highspeed"
# Fallbacks (used only when MINIMAX_API_KEY is empty); DeepSeek = OpenAI-compatible
DEEPSEEK_API_KEY=""
QWEN_API_KEY=""
# Google Gemini (BL-027 daily-note) — OpenAI-compatible endpoint. Key set on worker only.
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
GEMINI_MODEL="gemini-3.5-flash"
# --- Daily Note (BL-027) ---
# skip a day's note unless this many substantive inputs exist (no thin articles)
DAILY_NOTE_MIN_ITEMS="4"
# autopublish reviewed notes (default ON; set "false" to hold as drafts)
DAILY_NOTE_AUTOPUBLISH="true"

# --- Python scraper service (Railway) ---
SCRAPER_SERVICE_URL="http://localhost:8000"
# Items processed per crawl (newest-first). Caps AI cost on big feeds
# (e.g. Shopify changelog ~1500). Default 12.
MAX_ITEMS_PER_CRAWL="12"

# --- X (Twitter) viral-products signal (Radar only) ---
# App-only Bearer token → GET /2/tweets/search/recent. X is pay-per-read
# (~$0.005/post): X_MAX_READS_PER_DAY is a HARD cap (≤100 → ≤$0.50/day).
# Leave X_ENABLED unset/false until a token is set — the worker no-ops (zero cost).
# Dry-run first: pnpm tsx scripts/x-probe.ts
X_BEARER_TOKEN=""
X_ENABLED="false"
X_MAX_READS_PER_DAY="100"
# Engagement pre-filter floor (likes). Spec default 50; search/recent's 7-day
# index surfaces low-engagement tweets even under relevancy sort, so lower this
# (e.g. 5–10) if the Radar stays empty. 0 = keep all (rely on AI product filter).
X_MIN_LIKES="50"
# Curated-accounts track (BL-034): daily read cap for polling timelines
# (~$0.005/read → 200 ≈ $1/day). Shares the X_ENABLED kill-switch.
X_ACCOUNTS_MAX_READS="200"

# --- Logging ---
LOG_LEVEL="info"

# --- Neon Auth (admin /admin/* gating — ADR-006) ---
# Auth URL from Neon Console → Project → Branch → Auth → Configuration
NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=  # openssl rand -base64 32
ADMIN_EMAILS=you@example.com  # comma-separated allowlist (Google login emails)

# --- Analytics (GA4, optional; code defaults to the project ID) ---
NEXT_PUBLIC_GA_ID=G-4E8B257NHH
