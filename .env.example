# --- Postgres (Neon) — ADR-003 ---
# Pooled connection (host contains "-pooler"), used at runtime by workers & Vercel.
# Add &connection_limit=5 (long-lived worker) or =1 (serverless fn) to avoid
# exhausting Neon's pooled connections — see docs/operations.md.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/tradelinks?sslmode=require&pgbouncer=true&connection_limit=5"
# Direct connection (no -pooler): used by `prisma migrate` AND by pg-boss (ADR-004)
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/tradelinks?sslmode=require"

# --- AI ---
# Primary: MiniMax token-plan key (sk-cp-) → Anthropic-compatible endpoint.
# (M2 is a reasoning model; client floors max_tokens to leave room for thinking.)
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimax.io/anthropic"
MINIMAX_MODEL="MiniMax-M2.7-highspeed"
# Fallbacks (used only when MINIMAX_API_KEY is empty); DeepSeek = OpenAI-compatible
DEEPSEEK_API_KEY=""
QWEN_API_KEY=""

# --- Python scraper service (Railway) ---
SCRAPER_SERVICE_URL="http://localhost:8000"
# Items processed per crawl (newest-first). Caps AI cost on big feeds
# (e.g. Shopify changelog ~1500). Default 12.
MAX_ITEMS_PER_CRAWL="12"

# --- Logging ---
LOG_LEVEL="info"
