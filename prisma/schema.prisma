// TradeLinks data model — see docs/specs/data-model.md
// Postgres 16 + pg_trgm (trigram GIN indexes added via raw SQL migration 0002)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Neon pooled (-pooler host) — runtime queries
  directUrl = env("DIRECT_URL") // Neon direct — prisma migrate (ADR-003)
}

// ---------- Enums ----------

enum Region {
  north_america
  europe
  southeast_asia
  middle_east
  latin_america
  australia_nz
}

enum Category {
  regulatory
  platform_policy
  logistics
  trend
  industry
  tip
}

enum Adapter {
  rss
  fetch
  scrapling
}

enum ItemStatus {
  raw
  processed
  filtered
  failed
}

enum AlertStatus {
  pending_review
  published
  rejected
}

enum Tier {
  free
  pro
  team
  enterprise
}

enum PushChannel {
  email
  telegram
  slack
}

// ---------- Tables ----------

model Source {
  id                  String    @id
  name                String
  url                 String
  adapter             Adapter
  frequencyCron       String
  language            String
  regions             Region[]
  platforms           String[]
  categoryHint        Category?
  isActive            Boolean   @default(true)
  lastCrawledAt       DateTime?
  lastOkAt            DateTime?
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items Item[]

  @@map("sources")
}

model Item {
  id             String     @id @default(cuid())
  sourceId       String
  url            String     @unique
  urlHash        String     @unique
  title          String
  titleEn        String?
  summaryEn      String?
  imageUrl       String?
  rawContent     Json?
  publishedAt    DateTime
  crawledAt      DateTime   @default(now())
  status         ItemStatus @default(raw)
  regions        Region[]
  platforms      String[]
  category       Category?
  lang           String
  isDuplicate    Boolean    @default(false)
  clusterId      String?
  urgencyScore   Float?
  impactScope    String?
  recommendation String?

  source  Source   @relation(fields: [sourceId], references: [id])
  cluster Cluster? @relation(fields: [clusterId], references: [id])

  @@index([sourceId, crawledAt])
  @@index([status])
  @@index([publishedAt])
  @@index([clusterId])
  @@map("items")
}

model Cluster {
  id                   String   @id @default(cuid())
  representativeItemId String
  sourceUrls           String[]
  createdAt            DateTime @default(now())

  items Item[]

  @@map("clusters")
}

model Alert {
  id             String      @id @default(cuid())
  clusterId      String?
  title          String
  summary        String
  urgencyScore   Float
  regions        Region[]
  platforms      String[]
  category       Category
  affectedSkus   String[]
  actionRequired String?
  imageUrl       String?
  sourceUrls     String[]
  status         AlertStatus @default(pending_review)
  publishedAt    DateTime?
  reviewedBy     String?
  createdAt      DateTime    @default(now())

  @@index([status, urgencyScore])
  @@index([publishedAt])
  @@map("alerts")
}

model TrendSnapshot {
  id                 String    @id @default(cuid())
  date               DateTime  @db.Date
  region             Region
  category           Category?
  keyword            String
  rankAmazonBsr      Int?
  trendsScoreGoogle  Int?
  tiktokMentionCount Int?
  signalStrength     Float?

  @@unique([date, region, keyword])
  @@map("trend_snapshots")
}

model ProductSnapshot {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  asin        String
  region      Region
  category    String                     // 真实品类标签（"Beauty"/"Toys & Games"），非 categoryHint
  rank        Int?
  reviewCount Int?                        // Phase 2 富集，Phase 1 恒 null
  rating      Float?                      // Phase 2
  price       Float?                      // Phase 2
  title       String
  imageUrl    String?
  isCommodity Boolean  @default(false)
  sourceId    String
  createdAt   DateTime @default(now())

  @@unique([date, asin, region])
  @@index([asin, date])
  @@index([region, category, date])
  @@map("product_snapshots")
}

// The Movers (BL-044): one persisted AI insight card per mover per day. Written by the
// radar-review worker (evidence → generateInsight), surfaced on /radar. Text-only (no image).
model MoverInsight {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  asin         String
  region       Region
  category     String
  rank         Int?
  rankDelta    Int?
  reviewDelta  Int?
  isNewEntrant Boolean  @default(false)
  score        Float
  spreadingTo  Region[]
  title        String
  whatItIs     String
  whyNow       String
  trajectory   String
  soWhat       String
  model        String?
  createdAt    DateTime @default(now())

  @@unique([date, asin, region])
  @@index([date, score])
  @@map("mover_insights")
}

model TrendSignal {
  id           String   @id @default(cuid())
  keyword      String
  originRegion Region
  spreadingTo  Region[]
  confidence   Float
  signalBasis  String
  firstSeenAt  DateTime @default(now())

  @@map("trend_signals")
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  tier             Tier          @default(free)
  stripeCustomerId String?
  subRegions       Region[]
  subPlatforms     String[]
  subCategories    Category[]
  pushChannels     PushChannel[]
  telegramChatId   String?
  slackWebhookUrl  String?
  createdAt        DateTime      @default(now())

  watches KeywordWatch[]

  @@map("users")
}

model KeywordWatch {
  id        String   @id @default(cuid())
  userId    String
  keyword   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("keyword_watches")
}

// Daily per-source health snapshot — powers the /admin/sources dashboard's
// trend lines + regression alerts. One row per source per day (small).
model SourceHealthSnapshot {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  sourceId  String
  score     Int
  tier      String
  items24h  Int
  fails     Int
  createdAt DateTime @default(now())

  @@unique([date, sourceId])
  @@index([sourceId, date])
  @@map("source_health_snapshots")
}

// Channel Push (BL-039): tracks items pushed to the public Telegram channel.
// Unique constraint prevents double-push; pushedAt drives the daily budget.
model ChannelPush {
  id        String   @id @default(cuid())
  itemType  String   // "alert" | "product"
  itemId    String   // alert.id | "bestseller:<key>" | "viral:<key>"
  channelId String   // TELEGRAM_CHANNEL_ID at push time
  messageId String?  // telegram message_id, for future edit/delete
  pushedAt  DateTime @default(now())

  @@unique([itemType, itemId, channelId])
  @@index([pushedAt])
  @@map("channel_pushes")
}

// Daily Note (BL-027): one original editorial article per day, per language, per
// kind (brief = policy interpretation, roundup = viral-product roundup). Written
// by the editor model, fact-checked + de-AI'd by the reviewer, human-approved
// before publish. Crawlable at /daily/[slug] — the SEO content asset.
model DailyNote {
  id              String    @id @default(cuid())
  date            DateTime  @db.Date          // the D-1 UTC date the note covers
  slug            String    @unique
  lang            String    @default("en")
  kind            String    @default("brief")  // brief | roundup
  title           String
  dek             String?
  bodyMarkdown    String
  keyTakeaways    String[]
  metaDescription String?
  heroImageUrl    String?
  tags            String[]
  citations       Json?                         // [{title,url}] — from inputs, not the model
  sourceAlertIds  String[]
  status          String    @default("draft")   // draft | published | skipped
  model           String?                        // editor LLM
  reviewModel     String?                        // reviewer LLM
  removedClaims   String[]                        // reviewer audit
  publishedAt     DateTime?
  reviewedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([date, lang, kind])
  @@index([status, publishedAt])
  @@map("daily_notes")
}

model Translation {
  id         String   @id @default(cuid())
  entityType String   // "alert" | "product" | "xtopic"
  entityId   String   // stable key, e.g. "alert:<id>", "bestseller:<url>", "viral:<link>"
  lang       String   // BCP-47 short code, e.g. "zh"
  fields     Json     // { title?, summary?, actionRequired? } — translatable fields only
  sourceHash String   // hash of the source fields at translation time
  model      String?  // LLM used, for provenance
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId, lang])
  @@index([entityType, lang])
  @@map("translations")
}

model Subscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  status         String    @default("pending") // pending | confirmed | unsubscribed
  lang           String    @default("en")
  confirmToken   String    @unique
  unsubToken     String    @unique
  createdAt      DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?

  @@index([status])
  @@map("subscribers")
}
