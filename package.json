{
  "name": "tradelinks-mvp",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/workers/index.ts",
    "worker:run-once": "tsx src/workers/run-once.ts",
    "patrol": "tsx scripts/patrol.ts",
    "job": "tsx scripts/run-job.ts",
    "db:gen": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:prod": "DOTENV_CONFIG_PATH=.env.production node -r dotenv/config node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:staging": "DOTENV_CONFIG_PATH=.env.staging node -r dotenv/config node_modules/prisma/build/index.js migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:diff": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/auth": "0.4.1-beta",
    "@next/third-parties": "^16.2.7",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^4.9.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.28.0",
    "next": "^14.2.35",
    "pg-boss": "^10.1.5",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.0",
    "jsdom": "26.1.0",
    "postcss": "^8.5.15",
    "prisma": "^6.2.1",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
